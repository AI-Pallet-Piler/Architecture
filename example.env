# =============================================================================
# UNIFIED ENVIRONMENT CONFIGURATION
# AI-Pallet-Piler Project
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=wms_database
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Database URL for Backend service
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# BACKEND API CONFIGURATION
# -----------------------------------------------------------------------------
BACKEND_PORT=8000

# JWT Configuration
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# API GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8080

# Backend URL for API Gateway
url_backend=http://backend:8000/api/v1
check_upstream_services=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/api_gateway.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# SECURITY API CONFIGURATION
# -----------------------------------------------------------------------------
SECURITY_API_PORT=8090

# JWT Auth Service Configuration
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7

# External User Service Configuration
USER_SERVICE_URL=http://backend:8000
USER_SERVICE_API_KEY=
USER_SERVICE_TIMEOUT=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=jwt_auth:

# Token Storage Configuration
ROTATE_REFRESH_TOKEN=true
MAX_ACTIVE_REFRESH_PER_USER=5

# -----------------------------------------------------------------------------
# FRONTEND WEB CONFIGURATION
# -----------------------------------------------------------------------------
FRONTEND_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# SHARED CONFIGURATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1